{
  "name": "qwen3-public",
  "uris": ["/qwen3", "/qwen3/*"],
  "upstream": {
    "type": "roundrobin",
    "nodes": {
      "qwen3-model-worker.llm-models.svc.cluster.local:8080": 1
    }
  },
  "plugins": {
    "key-auth": {
      "header": "X-API-Key",
      "hide_credentials": true
    },
    "serverless-pre-function": {
      "phase": "rewrite",
      "functions": [
        "return function(conf, ctx) local auth = ngx.var.http_authorization; if auth then local token = string.match(auth, '^[Bb][Ee][Aa][Rr][Ee][Rr]%s+(%S+)%s*$'); if token then ngx.req.set_header('X-API-Key', token) end end end"
      ]
    },
    "proxy-rewrite": {
      "regex_uri": ["^/qwen3/?(.*)$", "/$1"]
    },
    "limit-count": {
      "count": 600,
      "time_window": 60,
      "rejected_code": 429,
      "key": "consumer_name",
      "policy": "local"
    }
  }
}
