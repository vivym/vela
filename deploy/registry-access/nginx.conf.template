worker_processes 2;
user nginx;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
    access_log off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 0;
    # Reject ambiguous raw paths before applying repository authorization.
    map $request_uri $bad_path {
        default 0;
        ~^[^?]*% 1;
        ~^[^?]*/\.\.?(/|\?|$) 1;
        ~^[^?]*// 1;
    }
    map $uri $repo_scope {
        default platform;
        /v2/ handshake;
        /v2/_catalog catalog;
        ~^/v2/llm-api/ llm-api;
        ~^/v2/llm-models/ llm-models;
    }
    # Cross-repository blob mounts must not let a tenant borrow private blobs.
    map "$repo_scope:$arg_from" $foreign_mount {
        default 1;
        ~^[^:]+:$ 0;
        ~^llm-api:llm-api/ 0;
        ~^llm-models:llm-models/ 0;
        ~^platform: 0;
    }
    map "$foreign_mount:$request_method:$repo_scope" $auth_file {
        default /auth/platform-write;
        ~^0:(GET|HEAD):handshake$ /auth/handshake;
        ~^0:(GET|HEAD):platform$ /auth/platform-read;
        ~^0:(GET|HEAD):llm-api$ /auth/llm-api-read;
        ~^0:(GET|HEAD):llm-models$ /auth/llm-models-read;
        ~^0:(POST|PATCH|PUT):llm-api$ /auth/llm-api-write;
        ~^0:(POST|PATCH|PUT):llm-models$ /auth/llm-models-write;
    }
    server {
        listen __LISTEN__ ssl;
        server_name _;
        ssl_certificate /certs/registry.crt;
        ssl_certificate_key /certs/registry.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:registry_tls:10m;
        if ($bad_path) { return 400; }
        location /v2/ {
            auth_basic "Vela release registry";
            auth_basic_user_file $auth_file;
            proxy_pass https://__UPSTREAM__;
            proxy_ssl_verify on;
            proxy_ssl_verify_depth 3;
            proxy_ssl_trusted_certificate /trust/registry-ca.crt;
            proxy_ssl_name __CERT_HOST__;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Authorization "";
            proxy_http_version 1.1;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
            add_header Docker-Distribution-Api-Version registry/2.0 always;
        }
        location / { return 404; }
    }
}
