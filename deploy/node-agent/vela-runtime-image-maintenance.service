[Unit]
Description=Vela runtime image observation maintenance
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/vela-node-agent runtime-image-maintenance --config-file /etc/vela/runtime-image-maintenance.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=40s
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
