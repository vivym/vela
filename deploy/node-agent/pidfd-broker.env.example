# The GID of the non-root Runtime/Worker identity that may submit retained
# pidfds. The broker compares handles in the host PID namespace; it never
# accepts numeric PIDs or reopens a process from serialized metadata.
VELA_PIDFD_BROKER_SOCKET=/run/vela-pidfd-broker/broker.sock
VELA_PIDFD_BROKER_RUNTIME_GID=65532
