# Root-owned key used only to sign short-lived Node policy replies.
VELA_RUNTIME_POLICY_PRIVATE_KEY_FILE=/etc/vela/runtime-policy-issuer/reply-private.key
# Fleet-side public key. The issuer refuses requests without a matching,
# unconsumed authorization file signed by this key.
VELA_RUNTIME_POLICY_AUTHORIZATION_PUBLIC_KEY_FILE=/etc/vela/runtime-policy-issuer/fleet-authorization.pub
VELA_RUNTIME_POLICY_AUTHORIZATION_DIRECTORY=/var/lib/vela/runtime-policy-issuer/authorizations
VELA_RUNTIME_POLICY_REPLY_CACHE_DIRECTORY=/var/lib/vela/runtime-policy-issuer/replies
VELA_RUNTIME_POLICY_ISSUER_SOCKET=/run/vela-runtime-policy/issuer.sock
VELA_RUNTIME_POLICY_RUNTIME_GID=65532

# The issuer reads both raw Ed25519 key files with private-file checks.
# Install reply-private.key (64 bytes) and fleet-authorization.pub (32 bytes)
# as root:root mode 0600, including the public key; mode 0644 is rejected.
