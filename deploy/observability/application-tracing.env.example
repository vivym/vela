# For a release built with internal/tracing. This file is a template and is
# not applied to the current cluster by the observability kustomization.
# Mount/copy these variables into each intended application process; do not
# assume a host launcher passes its own environment to an isolated ModelRuntime.
VELA_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring.svc.cluster.local:4318
OTEL_TRACES_SAMPLER_ARG=0.1
