{
  "uid": "vela-hardware-ipmi",
  "title": "Vela \u00b7 IPMI Hardware",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "vela",
    "hardware"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Read-only federation from the existing Prometheus on 10.1.201.70. Missing telemetry is unknown, not healthy. Collection on protected hosts is unchanged.",
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "BMC",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vela-prometheus"
        },
        "query": {
          "query": "label_values(ipmi_up{job=~\"ipmi(-.*)?\"},instance)",
          "refId": "BMC"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Federation reachable",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vela-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"legacy-hardware-federation\"}",
          "legendFormat": "{{instance}} {{collector}} {{name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "BMC collectors failing",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vela-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ipmi_up{job=~\"ipmi(-.*)?\",instance=~\"$instance\"} == 0) or (0 * count(ipmi_up{job=~\"ipmi(-.*)?\",instance=~\"$instance\"}))",
          "legendFormat": "{{instance}} {{collector}} {{name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "BMC telemetry hosts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vela-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by(instance) (ipmi_up{job=~\"ipmi(-.*)?\",instance=~\"$instance\"}))",
          "legendFormat": "{{instance}} {{collector}} {{name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "BMC telemetry age",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vela-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(time() - timestamp(ipmi_up{job=~\"ipmi(-.*)?\",instance=~\"$instance\"}))",
          "legendFormat": "{{instance}} {{collector}} {{name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "BMC collector health",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "vela-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ipmi_up{job=~\"ipmi(-.*)?\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{collector}} {{name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Temperature",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vela-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ipmi_temperature_celsius{job=~\"ipmi(-.*)?\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{collector}} {{name}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Fan speed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vela-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ipmi_fan_speed_rpm{job=~\"ipmi(-.*)?\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{collector}} {{name}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rpm",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Chassis power state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "vela-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ipmi_chassis_power_state{job=~\"ipmi(-.*)?\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}} {{collector}} {{name}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
