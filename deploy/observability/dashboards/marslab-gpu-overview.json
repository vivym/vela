{
  "uid": "vela-marslab-gpu-overview",
  "title": "MarsLab NVIDIA GPU Overview · Kubernetes",
  "tags": [
    "marslab",
    "gpu",
    "nvidia",
    "vela",
    "imported-marslab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "GPU Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vela-prometheus"
        },
        "query": {
          "query": "label_values(nvidia_gpu_utilization_percent, instance)",
          "refId": "gpu-node-var"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "gpu",
        "label": "GPU",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vela-prometheus"
        },
        "query": {
          "query": "label_values(nvidia_gpu_utilization_percent{instance=~\"$instance\"}, gpu)",
          "refId": "gpu-var"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "GPU Nodes Up",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "vela-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vela-prometheus"
          },
          "expr": "count(nvidia_smi_up{job=\"nvidia-smi\",instance=~\"$instance\"} == 1)",
          "legendFormat": "nodes",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
