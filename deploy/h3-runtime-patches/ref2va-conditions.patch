     def bind_materials(request, materials):
         canonical = request.extra[MINIMAX_H3_CANONICAL_REQUEST_EXTRA_KEY]
-        if materials or canonical.get("conditions") or canonical.get("task") != "t2va":
-            raise ValueError("native H3 boundary accepts text-only t2va")
+        task = canonical.get("task")
+        conditions = canonical.get("conditions") or []
+        if task == "t2va":
+            if materials or conditions:
+                raise ValueError("native H3 t2va boundary accepts no conditions")
+            return
+        if task not in {"fl2va", "ref2va"}:
+            raise ValueError(f"native H3 boundary does not support task {task!r}")
+        if not isinstance(materials, list) or len(materials) != len(conditions):
+            raise ValueError(
+                "native H3 condition materials must match canonical conditions"
+            )
+        cache = request.extra.setdefault("minimax_h3_material_localization", {})
+        seen: set[int] = set()
+        for material in materials:
+            if not isinstance(material, Mapping):
+                raise ValueError("native H3 condition material is invalid")
+            index = material.get("condition_index")
+            uri = material.get("uri")
+            local_path = material.get("local_path")
+            if type(index) is not int or index < 0 or index >= len(conditions):
+                raise ValueError("native H3 condition material index is invalid")
+            if index in seen or uri != conditions[index].get("uri"):
+                raise ValueError(
+                    "native H3 condition material identity disagrees with canonical request"
+                )
+            if not isinstance(local_path, str) or not Path(local_path).is_absolute():
+                raise ValueError("native H3 condition material path must be absolute")
+            path = Path(local_path)
+            if not path.is_file() or path.is_symlink():
+                raise ValueError(
+                    "native H3 condition material must be a regular local file"
+                )
+            cache[uri] = str(path)
+            seen.add(index)
+        if seen != set(range(len(conditions))):
+            raise ValueError("native H3 condition materials are incomplete")
+
