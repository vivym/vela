{
  "apiVersion": "vela.ai/v1alpha1",
  "kind": "VelaControlSecretContract",
  "releaseRevision": "r0-placeholder",
  "rotationPolicy": {
    "mode": "new-secret-name-and-rolling-update",
    "inPlaceUpdateSupported": false,
    "immutableRequired": true
  },
  "environmentSecrets": [
    {
      "name": "vela-control-database-urls-r0-placeholder",
      "requiredKeys": [
        "VELA_ARTIFACT_REPLICATION_DATABASE_URL",
        "VELA_ARTIFACT_REQUEST_DATABASE_URL",
        "VELA_ATTEMPT_COORDINATOR_DATABASE_URL",
        "VELA_AUTH_DATABASE_URL",
        "VELA_BACKUP_RETENTION_DATABASE_URL",
        "VELA_BILLING_DATABASE_URL",
        "VELA_BREAK_GLASS_AUDIT_DATABASE_URL",
        "VELA_BREAK_GLASS_REQUEST_DATABASE_URL",
        "VELA_CANCEL_DATABASE_URL",
        "VELA_COMPLIANCE_DATABASE_URL",
        "VELA_DEBUG_DUMP_AUDIT_REQUEST_DATABASE_URL",
        "VELA_DEBUG_DUMP_REQUEST_DATABASE_URL",
        "VELA_FINANCE_RECONCILIATION_DATABASE_URL",
        "VELA_FLEET_DATABASE_URL",
        "VELA_HUMAN_AUTH_DATABASE_URL",
        "VELA_HUMAN_MEMBERSHIP_AUTH_DATABASE_URL",
        "VELA_HUMAN_MEMBERSHIP_REQUEST_DATABASE_URL",
        "VELA_IDENTITY_REQUEST_DATABASE_URL",
        "VELA_INTERNAL_DATABASE_URL",
        "VELA_NON_CONTENT_EXPIRY_DATABASE_URL",
        "VELA_ORGANIZATION_AUDIT_REQUEST_DATABASE_URL",
        "VELA_ORGANIZATION_BILLING_REQUEST_DATABASE_URL",
        "VELA_PLATFORM_OPERATOR_AUTH_DATABASE_URL",
        "VELA_REMEDIATION_DATABASE_URL",
        "VELA_REQUEST_DATABASE_URL",
        "VELA_RETENTION_DATABASE_URL",
        "VELA_RETENTION_REQUEST_DATABASE_URL",
        "VELA_STAGE_SCHEDULER_DATABASE_URL",
        "VELA_STAGE_ARTIFACT_DATABASE_URL",
        "VELA_STAGE_WORKER_CONTROL_DATABASE_URL",
        "VELA_WEBHOOK_DATABASE_URL",
        "VELA_WEBHOOK_REQUEST_DATABASE_URL"
      ]
    },
    {
      "name": "vela-control-credential-pepper-r0-placeholder",
      "requiredKeys": [
        "VELA_CREDENTIAL_PEPPER_BASE64"
      ]
    }
  ],
  "fileSecrets": [
    {
      "name": "vela-control-transport-tls-r0-placeholder",
      "requiredKeys": [
        "fleet-client-ca.crt",
        "fleet-tls.crt",
        "fleet-tls.key",
        "stage-worker-client-ca.crt",
        "stage-worker-tls.crt",
        "stage-worker-tls.key",
        "worker-client-ca.crt",
        "worker-tls.crt",
        "worker-tls.key"
      ],
      "projectedPath": "/projected/control-transport",
      "materializedPaths": {
        "fleet-client-ca.crt": "/materialized/fleet/client-ca.crt",
        "fleet-tls.crt": "/materialized/fleet/tls.crt",
        "fleet-tls.key": "/materialized/fleet/tls.key",
        "stage-worker-client-ca.crt": "/materialized/stage-worker/client-ca.crt",
        "stage-worker-tls.crt": "/materialized/stage-worker/tls.crt",
        "stage-worker-tls.key": "/materialized/stage-worker/tls.key",
        "worker-client-ca.crt": "/materialized/worker/client-ca.crt",
        "worker-tls.crt": "/materialized/worker/tls.crt",
        "worker-tls.key": "/materialized/worker/tls.key"
      }
    },
    {
      "name": "vela-control-stage-worker-identity-r0-placeholder",
      "requiredKeys": [
        "identity-key"
      ],
      "projectedPath": "/projected/stage-worker-identity",
      "materializedPaths": {
        "identity-key": "/materialized/stage-worker/identity-key"
      }
    },
    {
      "name": "vela-control-privileged-http-tls-r0-placeholder",
      "requiredKeys": [
        "compliance-client-ca.crt",
        "compliance-tls.crt",
        "compliance-tls.key",
        "finance-client-ca.crt",
        "finance-tls.crt",
        "finance-tls.key"
      ],
      "projectedPath": "/projected/privileged-http",
      "materializedPaths": {
        "compliance-client-ca.crt": "/materialized/compliance/client-ca.crt",
        "compliance-tls.crt": "/materialized/compliance/tls.crt",
        "compliance-tls.key": "/materialized/compliance/tls.key",
        "finance-client-ca.crt": "/materialized/finance/client-ca.crt",
        "finance-tls.crt": "/materialized/finance/tls.crt",
        "finance-tls.key": "/materialized/finance/tls.key"
      }
    },
    {
      "name": "vela-control-nats-client-r0-placeholder",
      "requiredKeys": [
        "ca.crt",
        "outbox.creds",
        "scheduler.creds",
        "tls.crt",
        "tls.key"
      ],
      "projectedPath": "/projected/nats",
      "materializedPaths": {
        "ca.crt": "/materialized/nats/ca.crt",
        "outbox.creds": "/materialized/nats/outbox.creds",
        "scheduler.creds": "/materialized/nats/scheduler.creds",
        "tls.crt": "/materialized/nats/tls.crt",
        "tls.key": "/materialized/nats/tls.key"
      }
    },
    {
      "name": "vela-control-artifact-credentials-r0-placeholder",
      "requiredKeys": [
        "backup-retention-access-key-id",
        "backup-retention-secret-access-key",
        "primary-access-key-id",
        "primary-secret-access-key",
        "replication-backup-access-key-id",
        "replication-backup-secret-access-key",
        "replication-source-access-key-id",
        "replication-source-secret-access-key"
      ],
      "projectedPath": "/projected/artifact",
      "materializedPaths": {
        "backup-retention-access-key-id": "/materialized/artifact/backup-retention-access-key-id",
        "backup-retention-secret-access-key": "/materialized/artifact/backup-retention-secret-access-key",
        "primary-access-key-id": "/materialized/artifact/primary-access-key-id",
        "primary-secret-access-key": "/materialized/artifact/primary-secret-access-key",
        "replication-backup-access-key-id": "/materialized/artifact/replication-backup-access-key-id",
        "replication-backup-secret-access-key": "/materialized/artifact/replication-backup-secret-access-key",
        "replication-source-access-key-id": "/materialized/artifact/replication-source-access-key-id",
        "replication-source-secret-access-key": "/materialized/artifact/replication-source-secret-access-key"
      }
    },
    {
      "name": "vela-control-keyrings-r0-placeholder",
      "requiredKeys": [
        "lease.json",
        "webhook.json"
      ],
      "projectedPath": "/projected/keyrings",
      "materializedPaths": {
        "lease.json": "/materialized/keyrings/lease.json",
        "webhook.json": "/materialized/keyrings/webhook.json"
      }
    },
    {
      "name": "vela-control-invoice-export-r0-placeholder",
      "requiredKeys": [
        "bearer-token"
      ],
      "projectedPath": "/projected/invoice",
      "materializedPaths": {
        "bearer-token": "/materialized/invoice/bearer-token"
      }
    },
    {
      "name": "vela-control-remediation-client-tls-r0-placeholder",
      "requiredKeys": [
        "ca.crt",
        "tls.crt",
        "tls.key"
      ],
      "projectedPath": "/projected/remediation-tls",
      "materializedPaths": {
        "ca.crt": "/materialized/remediation/ca.crt",
        "tls.crt": "/materialized/remediation/tls.crt",
        "tls.key": "/materialized/remediation/tls.key"
      }
    }
  ]
}
