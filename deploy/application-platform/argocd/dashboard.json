{
  "uid": "vela-platform-publishing",
  "title": "Vela / Platform Publishing",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "vela",
    "platform",
    "argocd"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Argo metrics targets",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{namespace=\"argocd\"})",
          "instant": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Applications",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(argocd_app_info)",
          "instant": true,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "title": "Application status",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "argocd_app_info",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Sync attempts by result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name, phase) (increase(argocd_app_sync_total[1h]))",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 5,
      "title": "Controller reconciliation time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(argocd_app_reconcile_bucket[5m])))",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "Argo container memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"argocd\",container!=\"\"})",
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "Publishing alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{service=\"platform-publishing\"}",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}
