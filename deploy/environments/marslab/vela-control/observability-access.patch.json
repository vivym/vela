[
  {
    "op": "replace",
    "path": "/spec/ingress",
    "value": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "monitoring"
              }
            },
            "podSelector": {
              "matchLabels": {
                "app.kubernetes.io/name": "prometheus"
              }
            }
          }
        ],
        "ports": [
          {
            "port": 8081,
            "protocol": "TCP"
          }
        ]
      }
    ]
  }
]
