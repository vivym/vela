apiVersion: v1
kind: Service
metadata:
  name: vela-lab-control
  namespace: vela-lab-v2
  labels:
    vela.ai/deployment-identity: vela-lab-v2
spec:
  selector:
    app.kubernetes.io/name: vela-lab-control
  ports:
    - name: http
      port: 8080
      targetPort: http
    - name: worker-grpc
      port: 8443
      targetPort: worker-grpc
    - name: fleet-grpc
      port: 8444
      targetPort: fleet-grpc
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: vela-lab-control
  namespace: vela-lab-v2
  labels:
    vela.ai/deployment-identity: vela-lab-v2
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: vela-lab-control
  template:
    metadata:
      labels:
        app.kubernetes.io/name: vela-lab-control
        app.kubernetes.io/component: control-plane
        vela.ai/environment: non-production-lab
        vela.ai/deployment-identity: vela-lab-v2
    spec:
      automountServiceAccountToken: false
      nodeSelector:
        vela.ai/node-role: control-storage
      terminationGracePeriodSeconds: 30
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: materialize-secrets
          image: __BOOTSTRAP_IMAGE__
          command: ["/bin/sh", "-ec"]
          args:
            - |
              for source in /projected/*; do
                [ -f "$source" ]
                name=${source##*/}
                temporary=/materialized/.${name}.tmp
                cp -L -- "$source" "$temporary"
                chmod 0400 "$temporary"
                mv -f -- "$temporary" "/materialized/$name"
              done
          securityContext:
            runAsNonRoot: true
            runAsUser: 10001
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: projected-files
              mountPath: /projected
              readOnly: true
            - name: materialized-files
              mountPath: /materialized
      containers:
        - name: control
          image: __CONTROL_IMAGE__
          imagePullPolicy: IfNotPresent
          env:
            - name: SSL_CERT_FILE
              value: /etc/vela-lab-control/ca.crt
          envFrom:
            - configMapRef:
                name: vela-lab-control-runtime
            - configMapRef:
                name: vela-lab-control-generated-public
            - secretRef:
                name: vela-lab-control-database-env
            - secretRef:
                name: vela-lab-control-secret-env
          ports:
            - name: http
              containerPort: 8080
            - name: management
              containerPort: 8081
            - name: worker-grpc
              containerPort: 8443
            - name: fleet-grpc
              containerPort: 8444
          readinessProbe:
            httpGet:
              path: /readyz
              port: management
            periodSeconds: 5
            failureThreshold: 12
          livenessProbe:
            httpGet:
              path: /healthz
              port: management
            periodSeconds: 10
          resources:
            requests:
              cpu: "1"
              memory: 2Gi
            limits:
              cpu: "8"
              memory: 12Gi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
            # RuntimeDefault rejects the namespace-bearing clone used by the
            # inner ffprobe sandbox, while the runtime AppArmor profile rejects
            # its private mount namespace. These exceptions are lab-only.
            appArmorProfile:
              type: Unconfined
            seccompProfile:
              type: Unconfined
          volumeMounts:
            - name: materialized-files
              mountPath: /etc/vela-lab-control
              readOnly: true
            - name: artifact-validation
              mountPath: /var/lib/vela-lab-v2/control-plane/artifact-validation
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: projected-files
          secret:
            secretName: vela-lab-control-files
            defaultMode: 0400
        - name: materialized-files
          emptyDir: {}
        - name: artifact-validation
          hostPath:
            path: /var/lib/vela-lab-v2/control-plane/artifact-validation
            type: Directory
        - name: tmp
          emptyDir: {}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: vela-lab-fleet-controller
  namespace: vela-lab-v2
  labels:
    vela.ai/deployment-identity: vela-lab-v2
automountServiceAccountToken: true
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: vela-lab-fleet-controller
  namespace: vela-lab-v2
  labels:
    vela.ai/deployment-identity: vela-lab-v2
rules:
  - apiGroups: [""]
    resources: ["pods", "services", "secrets"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: ["resource.k8s.io"]
    resources: ["resourceclaimtemplates"]
    verbs: ["get", "list", "watch", "create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: vela-lab-fleet-controller
  namespace: vela-lab-v2
  labels:
    vela.ai/deployment-identity: vela-lab-v2
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: vela-lab-fleet-controller
subjects:
  - kind: ServiceAccount
    name: vela-lab-fleet-controller
    namespace: vela-lab-v2
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: vela-lab-fleet-rollouts
  namespace: vela-lab-v2
  labels:
    vela.ai/deployment-identity: vela-lab-v2
immutable: true
data:
  rollouts.json: '{"schema_version":1,"rollouts":[]}'
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: vela-lab-fleet-controller
  namespace: vela-lab-v2
  labels:
    vela.ai/deployment-identity: vela-lab-v2
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: vela-lab-fleet-controller
  template:
    metadata:
      labels:
        app.kubernetes.io/name: vela-lab-fleet-controller
        app.kubernetes.io/component: fleet-controller
        vela.ai/environment: non-production-lab
        vela.ai/deployment-identity: vela-lab-v2
    spec:
      serviceAccountName: vela-lab-fleet-controller
      automountServiceAccountToken: true
      nodeSelector:
        vela.ai/node-role: control-storage
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: fleet-controller
          image: __FLEET_CONTROLLER_IMAGE__
          imagePullPolicy: IfNotPresent
          env:
            - {name: VELA_FLEET_NAMESPACE, value: "vela-lab-v2"}
            - {name: VELA_FLEET_RESIDENCY_PLAN_ROLLOUTS_FILE, value: "/etc/vela-fleet/rollouts.json"}
            - {name: VELA_FLEET_MAINTENANCE_ADDRESS, value: "vela-lab-control.vela-lab-v2.svc:8444"}
            - {name: VELA_FLEET_MAINTENANCE_SERVER_NAME, value: "vela-lab-control.vela-lab-v2.svc"}
            - {name: VELA_FLEET_TLS_CERT_FILE, value: "/etc/vela-fleet/private/tls.crt"}
            - {name: VELA_FLEET_TLS_KEY_FILE, value: "/etc/vela-fleet/private/tls.key"}
            - {name: VELA_FLEET_CA_FILE, value: "/etc/vela-fleet/private/ca.crt"}
            - {name: VELA_FLEET_ADMISSION_ADDRESS, value: ":9443"}
            - {name: VELA_FLEET_ADMISSION_TLS_CERT_FILE, value: "/etc/vela-fleet/private/admission.crt"}
            - {name: VELA_FLEET_ADMISSION_TLS_KEY_FILE, value: "/etc/vela-fleet/private/admission.key"}
            - {name: VELA_FLEET_ADMISSION_CLIENT_CA_FILE, value: "/etc/vela-fleet/private/admission-client-ca.crt"}
            - {name: VELA_FLEET_ADMISSION_CLIENT_SPIFFE_ID, value: "spiffe://vela.internal/kube-apiserver/admission"}
            - {name: VELA_FLEET_KUBERNETES_USERNAME, value: "system:serviceaccount:vela-lab-v2:vela-lab-fleet-controller"}
            - {name: VELA_FLEET_POLL_INTERVAL, value: "5s"}
          ports:
            - {name: admission, containerPort: 9443}
          readinessProbe:
            httpGet: {path: /readyz, port: admission, scheme: HTTPS}
            periodSeconds: 5
            failureThreshold: 12
          livenessProbe:
            httpGet: {path: /healthz, port: admission, scheme: HTTPS}
            periodSeconds: 10
          resources:
            requests: {cpu: "100m", memory: 128Mi}
            limits: {cpu: "1", memory: 512Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: ["ALL"]}
            readOnlyRootFilesystem: true
          volumeMounts:
            - {name: rollouts, mountPath: /etc/vela-fleet/rollouts.json, subPath: rollouts.json, readOnly: true}
            - {name: tls, mountPath: /etc/vela-fleet/private, readOnly: true}
            - {name: tmp, mountPath: /tmp}
      volumes:
        - name: rollouts
          configMap:
            name: vela-lab-fleet-rollouts
            defaultMode: 0400
        - name: tls
          secret:
            secretName: vela-lab-fleet-files
            defaultMode: 0400
        - {name: tmp, emptyDir: {}}
