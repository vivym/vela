apiVersion: batch/v1
kind: Job
metadata:
  generateName: vela-lab-smoke-
  namespace: vela-lab-v2
  labels:
    app.kubernetes.io/name: vela-lab-smoke
    vela.ai/environment: non-production-lab
    vela.ai/deployment-identity: vela-lab-v2
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 420
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: vela-lab-smoke
        app.kubernetes.io/component: smoke
        vela.ai/environment: non-production-lab
        vela.ai/deployment-identity: vela-lab-v2
    spec:
      automountServiceAccountToken: false
      restartPolicy: Never
      nodeSelector:
        vela.ai/node-role: control-storage
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: materialize-credential
          image: __BOOTSTRAP_IMAGE__
          imagePullPolicy: IfNotPresent
          command: ["/bin/sh", "-ec"]
          args:
            - |
              for name in bearer-credential ca.crt; do
                source=/projected/$name
                temporary=/materialized/.$name.tmp
                cp -L -- "$source" "$temporary"
                chmod 0400 "$temporary"
                mv -f -- "$temporary" "/materialized/$name"
              done
          resources:
            requests:
              cpu: 10m
              memory: 8Mi
            limits:
              cpu: 100m
              memory: 16Mi
          securityContext:
            runAsNonRoot: true
            runAsUser: 10001
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: projected-credential
              mountPath: /projected
              readOnly: true
            - name: materialized-credential
              mountPath: /materialized
      containers:
        - name: smoke
          image: __BOOTSTRAP_IMAGE__
          imagePullPolicy: IfNotPresent
          command: ["/usr/local/bin/vela-lab-smoke"]
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
          volumeMounts:
            - name: materialized-credential
              mountPath: /etc/vela-lab-smoke
              readOnly: true
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: projected-credential
          secret:
            secretName: vela-lab-smoke-credential
            defaultMode: 0400
        - name: materialized-credential
          emptyDir: {medium: Memory, sizeLimit: 1Mi}
        - name: tmp
          emptyDir: {}
