{
  "apiVersion": "vela.ai/v1alpha1",
  "kind": "VelaStageWorkerSecretContract",
  "releaseRevision": "r0-placeholder",
  "rotationPolicy": {
    "mode": "new-secret-name-and-residency-rollout",
    "inPlaceUpdateSupported": false,
    "immutableRequired": true
  },
  "fileSecrets": [
    {
      "name": "vela-stage-worker-control-mtls-r0-placeholder",
      "requiredKeys": ["ca.crt", "tls.crt", "tls.key"],
      "projectedPath": "/projected/control",
      "materializedPaths": {
        "ca.crt": "/etc/vela-stage-worker/private/control/ca.crt",
        "tls.crt": "/etc/vela-stage-worker/private/control/tls.crt",
        "tls.key": "/etc/vela-stage-worker/private/control/tls.key"
      }
    },
    {
      "name": "vela-stage-worker-authority-r0-placeholder",
      "requiredKeys": ["keyring.json"],
      "projectedPath": "/projected/authority",
      "materializedPaths": {
        "keyring.json": "/etc/vela-stage-worker/private/authority/keyring.json"
      }
    },
    {
      "name": "vela-stage-worker-artifact-credentials-r0-placeholder",
      "requiredKeys": ["access-key-id", "secret-access-key"],
      "projectedPath": "/projected/artifact-credentials",
      "materializedPaths": {
        "access-key-id": "/etc/vela-stage-worker/private/artifact/access-key-id",
        "secret-access-key": "/etc/vela-stage-worker/private/artifact/secret-access-key"
      }
    },
    {
      "name": "vela-stage-worker-artifact-ca-r0-placeholder",
      "requiredKeys": ["ca.crt"],
      "projectedPath": "/projected/artifact-ca",
      "materializedPaths": {
        "ca.crt": "/etc/vela-stage-worker/private/artifact/ca.crt"
      }
    }
  ]
}
