+func (service *Service) executionCallAllowedLocked(verified stageauthority.Verified) error {
+	if service.active == nil || service.active.verified.Digest != verified.Digest {
+		return errActiveAuthorityMismatch
+	}
+	if service.active.deadlineExpired {
+		return errExecutionDeadline
+	}
+	if service.active.pendingCancellations != 0 {
+		return errExecutionCancellation
+	}
+	select {
+	case <-service.closed:
+		return errors.New("ModelRuntime service is closed")
+	default:
+		return nil
+	}
