+func journalEndpointRunSupervisor(t *testing.T, socket string, request journalEndpointControl) {
+	t.Helper()
+	validator, err := stageauthority.NewValidator(map[string][]byte{"journal-test": bytes.Repeat([]byte{73}, 32)}, time.Now)
+	if err != nil {
+		t.Fatal(err)
+	}
