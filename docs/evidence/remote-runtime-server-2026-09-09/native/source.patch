+func newRemoteExecutionJournal(ctx context.Context, config RemoteExecutionJournalConfig) (*remoteExecutionJournal, error) {
+	if ctx == nil || config.Transport == nil || config.Timeout <= 0 || config.Timeout > 45*time.Second ||
