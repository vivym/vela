+	}
+}
+
+func TestRuntimeStartupAuthorityCompositionFailsClosedOnPolicyOrFleetEvidence(t *testing.T) {
+	for _, scenario := range []string{"invalid-policy-evidence", "missing-fleet-authorization"} {
