@@ -0,0 +1,269 @@
+//go:build integration && linux
+
+package nodeagent
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
