{
  "components": {
    "headers": {
      "RetryAfter": {
        "description": "Seconds before the client should retry Admission.",
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "parameters": {
      "DeliveryId": {
        "in": "path",
        "name": "delivery_id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        }
      },
      "JobId": {
        "in": "path",
        "name": "job_id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "ListLimit": {
        "in": "query",
        "name": "limit",
        "schema": {
          "default": 100,
          "format": "int32",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "ProjectId": {
        "in": "path",
        "name": "project_id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      },
      "SubscriptionId": {
        "in": "path",
        "name": "subscription_id",
        "required": true,
        "schema": {
          "format": "uuid",
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Request validation failed"
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Principal lacks the required Project scope"
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Credential is absent or invalid"
      }
    },
    "schemas": {
      "ArtifactAudio": {
        "additionalProperties": false,
        "properties": {
          "channels": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "codec": {
            "type": "string"
          },
          "duration_milliseconds": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "sample_rate": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "codec",
          "sample_rate",
          "channels",
          "duration_milliseconds"
        ],
        "type": "object"
      },
      "ArtifactDownload": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "format": "uuid",
            "type": "string"
          },
          "content_type": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "download_url": {
            "format": "uri",
            "type": "string"
          },
          "download_url_expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "kind": {
            "enum": [
              "VIDEO",
              "THUMBNAIL"
            ],
            "type": "string",
            "x-enum-varnames": [
              "VIDEO",
              "THUMBNAIL"
            ]
          },
          "media": {
            "$ref": "#/components/schemas/ArtifactMedia"
          },
          "object_version_id": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "ordinal": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "format": "int64",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "artifact_id",
          "kind",
          "ordinal",
          "object_version_id",
          "size_bytes",
          "sha256",
          "content_type",
          "download_url",
          "download_url_expires_at"
        ],
        "type": "object"
      },
      "ArtifactMedia": {
        "additionalProperties": false,
        "description": "Measured complete video and audio facts; duration_milliseconds is the video stream duration. Requested duration is separate and does not imply trimming.",
        "properties": {
          "audio": {
            "$ref": "#/components/schemas/ArtifactAudio"
          },
          "container_duration_milliseconds": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "duration_milliseconds": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "frame_count": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "frame_rate_milli": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          },
          "requested_duration_milliseconds": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "duration_milliseconds",
          "frame_count",
          "frame_rate_milli"
        ],
        "type": "object"
      },
      "ArtifactSet": {
        "additionalProperties": false,
        "properties": {
          "artifact_set_id": {
            "format": "uuid",
            "type": "string"
          },
          "artifacts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactDownload"
            },
            "minItems": 1,
            "type": "array"
          },
          "committed_at": {
            "format": "date-time",
            "type": "string"
          },
          "job_id": {
            "format": "uuid",
            "type": "string"
          },
          "retention_expires_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "artifact_set_id",
          "job_id",
          "retention_expires_at",
          "committed_at",
          "artifacts"
        ],
        "type": "object"
      },
      "CancelDecision": {
        "enum": [
          "CANCELED",
          "CANCELING",
          "ALREADY_SUCCEEDED",
          "ALREADY_FAILED"
        ],
        "type": "string"
      },
      "CancelResult": {
        "additionalProperties": false,
