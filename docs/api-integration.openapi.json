            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "charge_id": {
            "format": "uuid",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "posted_at": {
            "format": "date-time",
            "type": "string"
          },
          "reason": {
