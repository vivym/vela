            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Webhook Subscription is not visible in this Project"
          }
        },
        "summary": "Permanently disable a Webhook Subscription"
