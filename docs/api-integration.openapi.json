              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Delivery is nonterminal, disabled, or already replaying"
          }
        },
        "summary": "Manually replay a terminal Webhook Delivery"
