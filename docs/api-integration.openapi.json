          "event_types",
          "state",
          "secret_revision",
          "created_at"
        ],
        "type": "object"
      },
      "WebhookSubscriptionList": {
        "additionalProperties": false,
        "properties": {
          "subscriptions": {
            "items": {
              "$ref": "#/components/schemas/WebhookSubscription"
            },
            "maxItems": 100,
            "type": "array"
          }
        },
        "required": [
          "subscriptions"
        ],
        "type": "object"
      },
      "WebhookSubscriptionState": {
        "enum": [
          "ACTIVE",
          "DISABLED"
        ],
        "type": "string",
        "x-enum-varnames": [
          "ACTIVE",
          "DISABLED"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "VelaCredential",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Project-scoped asynchronous AI generation API.",
    "title": "Vela Video API - Relay Integration",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/projects/{project_id}/jobs": {
      "get": {
        "description": "Requires jobs:read. active=true includes all nonterminal states; false or omitted includes all states. state optionally narrows the result. Cursor pagination is a live view, not a frozen snapshot; restart without a cursor to refresh. Cursors are bound to the Project and filters.",
        "operationId": "listJobs",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "in": "query",
            "name": "active",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "state",
            "schema": {
              "$ref": "#/components/schemas/JobState"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            },
            "description": "Jobs visible in this Project; next_cursor is omitted on the last page"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "summary": "List Project Jobs, newest first"
      },
      "post": {
        "operationId": "submitJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "Job accepted durably"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Contract Credit Limit is insufficient"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Idempotency key was accepted with different content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Project queue limit is exhausted",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Compatible capacity is unavailable",
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          }
        },
        "summary": "Submit a Job for durable Admission"
      }
    },
    "/v1/projects/{project_id}/jobs/{job_id}": {
      "get": {
        "operationId": "getJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "description": "Current Job state"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Job is not visible in this Project"
          }
        },
        "summary": "Get authoritative Project Job state"
      }
    },
    "/v1/projects/{project_id}/jobs/{job_id}/artifacts": {
      "get": {
        "operationId": "getJobArtifacts",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactSet"
                }
              }
            },
            "description": "Committed ArtifactSet and exact-version downloads"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "ArtifactSet is not visible or not currently accessible"
          }
        },
        "summary": "Get the committed ArtifactSet with short-lived exact-version URLs"
      }
    },
    "/v1/projects/{project_id}/jobs/{job_id}/cancel": {
      "post": {
        "operationId": "cancelJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelResult"
                }
              }
            },
            "description": "Cancellation committed or replayed"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Job is not visible in this Project"
          }
        },
        "summary": "Commit a Customer Cancellation decision"
      }
    },
    "/v1/projects/{project_id}/webhook-subscriptions": {
      "get": {
        "operationId": "listWebhookSubscriptions",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/ListLimit"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookSubscriptionList"
                }
              }
            },
            "description": "Project Webhook Subscriptions without signing secrets"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "summary": "List safe Project Webhook Subscription projections"
      },
      "post": {
        "operationId": "createWebhookSubscription",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWebhookSubscriptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedWebhookSubscription"
                }
              }
            },
            "description": "Subscription created; the signing secret is returned once"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "summary": "Create a Project Webhook Subscription"
      }
    },
    "/v1/projects/{project_id}/webhook-subscriptions/{subscription_id}/deliveries": {
      "get": {
        "operationId": "listWebhookDeliveries",
